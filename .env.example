# =========================================================
# TRANSFER TALLY - ENVIRONMENT CONFIGURATION
# =========================================================

# Google Gemini API Key
# OPTIONAL: Receipts are read on-device with OCR by default. The key is only
# needed for the AI fallback (hybrid mode) or for AI-only mode.
# Get a free API key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model identifier used for receipt extraction.
# Any vision-capable Gemini model works (e.g. gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Optional: Per-IP request limit for /api/extract, per minute (default: 20).
# The Gemini free tier allows roughly 15 requests/minute — lower this if you
# see frequent 429 responses in production.
# RATE_LIMIT_PER_MINUTE=20

# Optional: Gemini fallback models (comma-separated, tried in order).
# The server uses them ONLY when the primary model answers 503
# (Google capacity/demand spike). Default: gemini-3.6-flash,gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
