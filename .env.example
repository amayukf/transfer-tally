# =========================================================
# TRANSFER TALLY - ENVIRONMENT CONFIGURATION
# =========================================================

# links.et API key — REQUIRED. Screenshots are verified against the bank
# through https://links.et/api/verify-image, proxied by src/app/api/verify.
# This is a server-side credential: never send it from the browser.
# Mint or revoke keys at https://links.et/dashboard/keys
LINKS_ET_API_KEY=

# Optional: per-IP request limit for /api/verify, per minute (default: 20).
# Every screenshot read is a metered links.et call, so this is the throttle.
# VERIFY_RATE_LIMIT_PER_MINUTE=20
